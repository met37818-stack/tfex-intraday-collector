# ==============================================================================
# Settrade Open API (v2) Credentials
# ==============================================================================
SETTRADE_APP_ID=your_settrade_app_id
SETTRADE_APP_SECRET=your_settrade_app_secret
SETTRADE_BROKER_ID=your_broker_id
SETTRADE_APP_CODE=ALGO
SETTRADE_IS_SANDBOX=false

# ==============================================================================
# Turso Cloud SQLite Database Credentials
# ==============================================================================
TURSO_DATABASE_URL=libsql://your-database-name-your-org.turso.io
TURSO_AUTH_TOKEN=your_turso_auth_token_here

# ==============================================================================
# Telegram Status Notification Credentials
# ==============================================================================
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here
